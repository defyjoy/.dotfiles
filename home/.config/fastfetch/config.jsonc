// Colors are ANSI names, so they follow the Noctalia terminal palette.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "left": 2, "right": 4 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 6 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
    { "type": "os",       "key": " " },
    { "type": "kernel",   "key": " " },
    { "type": "wm",       "key": " " },
    { "type": "shell",    "key": " " },
    { "type": "terminal", "key": " " },
    { "type": "packages", "key": "󰏖 " },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
    { "type": "cpu",      "key": " ", "format": "{name}" },
    { "type": "gpu",      "key": "󰢮 ", "format": "{name}", "hideType": "integrated" },
    { "type": "memory",   "key": " " },
    { "type": "disk",     "key": "󰋊 ", "folders": "/" },
    { "type": "display",  "key": "󰍹 ", "compactType": "original-with-refresh-rate" },
    { "type": "uptime",   "key": "󰅐 " },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
