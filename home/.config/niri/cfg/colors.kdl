// Generated by Noctalia from ~/.config/noctalia/templates/niri-colors.kdl - edit the template, not this file.
layout {
    focus-ring {
        width 2
        active-gradient from="#00696b" to="#2f628c" angle=135 relative-to="workspace-view"
        inactive-color "#f7f9ff00"
        urgent-color "#ba1a1a"
    }

    tab-indicator {
        active-color "#00696b"
        inactive-color "#6ff6f8"
        urgent-color "#ba1a1a"
    }

    insert-hint {
        color "#00696b80"
    }
}

recent-windows {
    highlight {
        active-color "#00696b"
        urgent-color "#ba1a1a"
    }
}
