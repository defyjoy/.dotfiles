// Generated by Noctalia from ~/.config/noctalia/templates/niri-colors.kdl - edit the template, not this file.
layout {
    focus-ring {
        width 2
        active-gradient from="#ffade6" to="#ffb4a4" angle=135 relative-to="workspace-view"
        inactive-color "#1e100d00"
        urgent-color "#ffb4ab"
    }

    tab-indicator {
        active-color "#ffade6"
        inactive-color "#732b64"
        urgent-color "#ffb4ab"
    }

    insert-hint {
        color "#ffade680"
    }
}

recent-windows {
    highlight {
        active-color "#ffade6"
        urgent-color "#ffb4ab"
    }
}
