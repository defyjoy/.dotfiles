    window-rule {
        geometry-corner-radius 2.5 // Set every window radius to 2.5
        clip-to-geometry true
    }

    // Blur only behind transparent windows (blurring every window is costly at 5120x1440).
    window-rule {
        match app-id="Alacritty"
        background-effect {
          blur true
          xray false
        }
    }

    // Frosted file manager.
    window-rule {
        match app-id="org.gnome.Nautilus"
        opacity 0.92
        background-effect {
          blur true
          xray false
        }
    }

    // Frosted Firefox toolbar/sidebar (translucent via userChrome.css; page content stays opaque).
    window-rule {
        match app-id="firefox"
        // Firefox uses CSD, so niri would fill the focus ring as a solid rect behind it.
        draw-border-with-background false
        background-effect {
          blur true
          xray false
        }
    }

    // Slightly dim unfocused windows; keep browsers, video and games solid.
    window-rule {
        match is-focused=false
        exclude app-id="firefox"
        exclude app-id=r#"^(mpv|vlc|steam_app_\d+|gamescope)$"#
        opacity 0.95
    }

    // Floating windows get a deeper shadow so they lift off the tiles.
    window-rule {
        match is-floating=true
        shadow {
            on
            softness 40
            spread 6
            offset x=0 y=10
            color "#000000a0"
        }
    }

    // Red ring on the window being screencast, so you always know what's shared.
    window-rule {
        match is-window-cast-target=true
        focus-ring {
            active-gradient from="#ff5f5f" to="#ff5f5f"
            inactive-color "#ff5f5f"
        }
    }

    // Never show password managers in screencasts.
    window-rule {
        match app-id=r#"^(org\.keepassxc\.KeePassXC|Bitwarden|1Password)$"#
        block-out-from "screencast"
    }

    // Firefox picture-in-picture: small, floating, bottom-right.
    window-rule {
        match app-id="firefox" title="^Picture-in-Picture$"
        open-floating true
        default-column-width { fixed 640; }
        default-window-height { fixed 360; }
        default-floating-position x=32 y=32 relative-to="bottom-right"
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }
