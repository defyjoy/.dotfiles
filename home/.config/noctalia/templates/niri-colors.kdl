// Generated by Noctalia from ~/.config/noctalia/templates/niri-colors.kdl - edit the template, not this file.
layout {
    focus-ring {
        width 2
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=135 relative-to="workspace-view"
        inactive-color "{{colors.surface.default.hex}}00"
        urgent-color "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
